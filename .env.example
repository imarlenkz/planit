# ───────── Planit configuration ─────────
# Copy to .env and adjust. Every variable is optional for a local demo.

# general
# development | staging | production
ENVIRONMENT=development
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
FRONTEND_ORIGINS=http://localhost
# true behind HTTPS
COOKIE_SECURE=false
HTTP_PORT=80

# database / cache (docker compose builds DATABASE_URL from these)
POSTGRES_USER=planit
POSTGRES_PASSWORD=planit
POSTGRES_DB=planit

# demo: seed demo school + run the demo scan through the pipeline on first start
SEED_DEMO=true
DEMO_AUTORUN=true

# storage
# local | s3
STORAGE_BACKEND=local
# 32-byte base64 key for AES-GCM encryption at rest: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
STORAGE_ENCRYPTION_KEY=
S3_ENDPOINT_URL=
S3_BUCKET=planit
S3_ACCESS_KEY=
S3_SECRET_KEY=
RETENTION_DAYS=365

# uploads & security
MAX_UPLOAD_MB=100
# e.g. clamav (with --profile clamav)
CLAMAV_HOST=
RATE_LIMIT_LOGIN_PER_MIN=10
RATE_LIMIT_UPLOAD_PER_MIN=30

# OCR
# tesseract | google | azure
OCR_PROVIDER=tesseract
# e.g. google,tesseract
OCR_FALLBACKS=
OCR_LANGUAGES=kaz+rus+eng
PDF_DPI=200
GOOGLE_VISION_API_KEY=
AZURE_VISION_ENDPOINT=
AZURE_VISION_KEY=

# AI evaluation of open answers
AI_ENABLED=true
# local (offline, rule-based) | openai | anthropic
AI_PROVIDER=local
AI_TIMEOUT_SEC=45
AI_SEND_STUDENT_NAMES=false
AI_SEND_IMAGES=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# confidence thresholds (%)
CONFIDENCE_HIGH=95
CONFIDENCE_MEDIUM=80
AUTO_APPROVE_HIGH_CONFIDENCE=true

# processes
API_WORKERS=2
WORKER_CONCURRENCY=2
