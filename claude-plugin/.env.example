# --- Claude API ---
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high
CLAUDE_EFFORT=medium
CLAUDE_MAX_TOKENS=16000
# default | off
CLAUDE_FALLBACKS=default

# --- MCP (claude.ai / Claude Code қосу) ---
# Ұзын кездейсоқ токен: openssl rand -hex 32  (бірнешеуі болса үтірмен)
MCP_TOKENS=
PUBLIC_HOST=ai.imarlen.kz

# --- Чат-виджет лимиттері (бір IP-ге) ---
CHAT_PER_MINUTE=10
CHAT_PER_DAY=200
# nginx X-Real-IP жібереді
TRUST_PROXY=true

# --- Сайттардың бот аккаунттары (sites.yaml ішінде ${...} ретінде) ---
PLANIT_BOT_EMAIL=
PLANIT_BOT_PASSWORD=
